+// BenchUp port of the upstream Python reader. A style is an archive object
+// even though BenchUp only imports the tag's name, color, and visibility.
+function readLayerLineStyle(ar: Archive, r: R): void {
+  if (ar.ver < 19 || r.pos + 2 > r.data.length) return;
+  const name = 'CCustomLineStyle';
+  const tag = r.peekU16();
+  if (tag === 0xffff) {
+    const at = r.pos + 4;
+    if (at + 2 + name.length > r.data.length ||
+        (r.data[at] | r.data[at + 1] << 8) !== name.length || !matchesAscii(r.data, at + 2, name)) return;
+  } else if (tag & 0x8000) {
+    const style = ar.classSlot.get(name);
+    const layer = ar.classSlot.get('CLayer');
+    const firstLayer = ar.firstLayerClass;
+    if (style === undefined || layer === undefined || firstLayer === undefined ||
+        style + layer - firstLayer !== (tag & 0x7fff)) return;
+  } else {
+    if (tag === 0 || tag === 0x7fff) return;
+    if (ar.walkBase >= (1 << 20)) {
+      if (!ar.seenLineStyle) return;
+    } else {
+      const entry = ar.slots.get(tag);
+      if (entry?.[0] !== 'obj' || entry[1] !== name) return;
+    }
+  }
+  ar.readObject(r, name);
+}
+
+function readCustomLineStyle(ar: Archive, r: R): object {
+  earlyPreamble(ar, r);
+  if (ar.ver < 20) earlyPreamble(ar, r);
+  r.utf16();
+  r.utf16();
+  r.raw(24);
+  ar.seenLineStyle = true;
+  return { k: 'linestyle' };
+}
